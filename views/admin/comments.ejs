<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <title>รายงานความคิดเห็น</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Sarabun&display=swap');

        body {
            font-family: 'Sarabun', sans-serif;
            background-color: #f3f4f6;
        }

        #deleteModal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        #deleteModal.hidden {
            display: none;
        }

        #deleteModal .modal-content {
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>

<body class="bg-gray-100 min-h-screen">
    <%- include('adminHd1') %>
        <!-- ปุ่มย้อนกลับ -->


        <main class="ml-64 pt-20 px-4 py-10">
            <div
                class="w-full max-w-screen-xl bg-white rounded-2xl shadow-xl p-10 transform transition-all duration-300">
                <h2 class="text-3xl font-extrabold text-center mb-6 text-teal-600">รายงานความคิดเห็นและการตอบกลับ</h2>

                <!-- แสดงคอมเมนต์ที่มีอยู่ -->
                <div class="bg-white p-8 rounded-2xl shadow-lg">
                    <h2 class="text-2xl font-semibold text-gray-800 mb-6">ความคิดเห็นทั้งหมด</h2>

                    <% comments.forEach(function(comment) { %>
                        <div class="mb-6 pb-6 border-b border-gray-200">
                            <div
                                class="p-6 bg-gray-50 rounded-xl shadow-sm border border-teal-300 transition-transform duration-300">
                                <div class="font-semibold text-gray-700 text-lg flex items-center space-x-2">
                                    <%= comment.fname %>
                                        <%= comment.lname %>
                                            <span class="text-sm text-gray-500">(<%= comment.role %>)</span>
                                            <span class="text-xs text-gray-400">(<%= new
                                                    Date(comment.created_at).toLocaleString() %>)</span>
                                </div>
                                <p class="text-gray-700 mt-2 text-base">
                                    <%= comment.commentText %>
                                </p>

                                <!-- ปุ่มลบสำหรับแอดมิน -->
                                <% if (user && (user.role==='แอดมิน' || user.userid===comment.userid)) { %>
                                    <button onclick="deleteComment('<%= comment.commentid %>')"
                                        class="text-red-500 hover:text-red-600 mt-2">ลบ</button>
                                    <% } %>

                                        <!-- แสดงการตอบกลับ -->
                                        <% if (comment.replies && comment.replies.length> 0) { %>
                                            <div class="mt-4 pl-6 border-l-4 border-teal-500">
                                                <h3 class="text-xl font-semibold text-gray-700 mb-4">การตอบกลับ</h3>
                                                <% comment.replies.forEach(function(reply) { %>
                                                    <div class="mt-2">
                                                        <div class="flex items-center space-x-2">
                                                            <span class="text-gray-700 font-semibold">
                                                                <%= reply.fname %>
                                                                    <%= reply.lname %>
                                                            </span>
                                                            <span class="text-sm text-gray-500">(<%= reply.role %>
                                                                    )</span>
                                                            <span class="text-sm text-gray-400">(<%= new
                                                                    Date(reply.replyDate).toLocaleString() %>)</span>
                                                        </div>
                                                        <p class="text-gray-600 mt-2 text-base">
                                                            <%= reply.replyText %>
                                                        </p>

                                                        <!-- ปุ่มลบสำหรับแอดมิน -->
                                                        <% if (user && (user.role==='แอดมิน' ||
                                                            user.userid===reply.userid)) { %>
                                                            <button onclick="deleteReply('<%= reply.replyid %>')"
                                                                class="text-red-500 hover:text-red-600 mt-2">ลบ</button>
                                                            <% } %>
                                                    </div>
                                                    <% }); %>
                                            </div>
                                            <% } %>
                            </div>
                        </div>
                        <% }); %>
                </div>


                <script>
                    let currentCommentId = null;
                    let currentReplyId = null;

                    async function deleteComment(commentid) {
                        Swal.fire({
                            title: 'คุณแน่ใจหรือไม่?',
                            text: "คุณต้องการลบความคิดเห็นนี้หรือไม่?",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#38b2ac',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'ลบ',
                            cancelButtonText: 'ยกเลิก'
                        }).then(async (result) => {
                            if (result.isConfirmed) {
                                const response = await fetch('/comment/delete', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ commentid })
                                });

                                const data = await response.json();
                                if (data.success) {
                                    Swal.fire({
                                        title: 'ลบแล้ว!',
                                        text: 'ความคิดเห็นถูกลบแล้ว',
                                        icon: 'success',
                                        confirmButtonText: 'ตกลง'
                                    }).then(() => location.reload());
                                } else {
                                    Swal.fire({
                                        title: 'เกิดข้อผิดพลาด',
                                        text: 'ไม่สามารถลบความคิดเห็นได้',
                                        icon: 'error',
                                        confirmButtonText: 'ตกลง'
                                    });
                                }
                            }
                        });
                    }
                    async function deleteReply(replyid) {
                        Swal.fire({
                            title: 'คุณแน่ใจหรือไม่?',
                            text: "คุณต้องการลบการตอบกลับนี้หรือไม่?",
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonColor: '#38b2ac',
                            cancelButtonColor: '#d33',
                            confirmButtonText: 'ลบ',
                            cancelButtonText: 'ยกเลิก'
                        }).then(async (result) => {
                            if (result.isConfirmed) {
                                const response = await fetch('/reply/delete', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ replyid })
                                });

                                const data = await response.json();
                                if (data.success) {
                                    Swal.fire({
                                        title: 'ลบแล้ว!',
                                        text: 'การตอบกลับถูกลบแล้ว',
                                        icon: 'success',
                                        confirmButtonText: 'ตกลง'
                                    }).then(() => location.reload());
                                } else {
                                    Swal.fire({
                                        title: 'เกิดข้อผิดพลาด',
                                        text: 'ไม่สามารถลบการตอบกลับได้',
                                        icon: 'error',
                                        confirmButtonText: 'ตกลง'
                                    });
                                }
                            }
                        });
                    }
                </script>
</body>

</html>