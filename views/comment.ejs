<% if (user) { %>
    <div class="bg-white p-8 rounded-2xl shadow-lg mb-8 border-t-4 border-teal-500 hover:scale-105">
        <form id="commentForm" action="/comment" method="POST">
            <div class="mb-6">
                <label for="commentText" class="block text-lg font-semibold text-gray-700">ความคิดเห็นของคุณ:</label>
                <textarea id="commentText" name="commentText" rows="6"
                    class="mt-2 p-4 border border-teal-300 rounded-lg w-full focus:ring-2 focus:ring-teal-500 focus:outline-none placeholder-gray-500 text-black"
                    placeholder="กรุณากรอกความคิดเห็น" required></textarea>
            </div>
            <input type="hidden" id="userid" name="userid" value="">
            <button type="submit"
                class="w-full py-3 bg-gradient-to-r from-teal-400 to-teal-500 text-white font-semibold rounded-lg shadow-lg hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-500 transition-all ease-in-out duration-300 hover:scale-105">
                เพิ่มความคิดเห็น
            </button>
        </form>
    </div>
<% } else { %>
    <div class="bg-white p-8 rounded-2xl shadow-lg mb-8 border-t-4 border-teal-500">
        <p class="text-teal-700">⚠️กรุณาล็อกอินเพื่อแสดงความคิดเห็น</p>
    </div>
<% } %>

                        <!-- แสดงคอมเมนต์ที่มีอยู่ -->
                        <div class="bg-white p-8 rounded-2xl shadow-lg border-t-4 border-teal-500">
                            <h2 class="text-2xl font-semibold text-gray-800 mb-6">ความคิดเห็น</h2>

                            <% comments.forEach(function(comment) { %>
                                <div class="mb-6 pb-6">
                                    <!-- กรอบคอมเมนต์ที่ดูง่ายขึ้น -->
                                    <div class="p-6 bg-gray-50 rounded-xl shadow-sm border border-teal-300">
                                        <div class="font-semibold text-gray-700 text-lg flex items-center space-x-2">
                                            <%= comment.fname %>
                                                <%= comment.lname %>
                                                    <span class="text-sm text-gray-500">(<%= comment.role %>)</span>
                                                    <span class="text-xs text-gray-400">(<%= new
                                                            Date(comment.created_at).toLocaleString() %>)</span>
                                        </div>
                                        <p class="text-gray-700 mt-2 text-base">
                                            <%= comment.commentText %>
                                        </p>

                                        <!-- ปุ่มแก้ไขและลบความคิดเห็น -->
                                        <% if (user && user.userid===comment.userid) { %>
                                            <button onclick="editComment('<%= comment.commentid %>')"
                                                class="text-teal-500 hover:text-teal-600">แก้ไข</button>
                                            <button onclick="deleteComment('<%= comment.commentid %>')"
                                                class="text-red-500 hover:text-red-600">ลบ</button>
                                            <% } %>

