    function editComment(commentid) {
    Swal.fire({
        title: 'แก้ไขความคิดเห็น',
        input: 'textarea',
        inputLabel: 'กรุณาแก้ไขข้อความ:',
        inputValue: '',
        showCancelButton: true,
        confirmButtonText: 'บันทึก',
        cancelButtonText: 'ยกเลิก',
        preConfirm: (newText) => {
            if (!newText) {
                Swal.showValidationMessage('กรุณาใส่ข้อความ');
            }
            return newText;
        }
    }).then((result) => {
        if (result.isConfirmed) {
            fetch('/comment/edit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ commentid, newText: result.value })
            }).then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('แก้ไขแล้ว!', 'ความคิดเห็นของคุณถูกแก้ไขแล้ว', 'success')
