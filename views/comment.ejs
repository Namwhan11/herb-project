<% if (user) { %>
    <div class="mt-6">
        <textarea id="replyText-<%= comment.commentid %>"
            class="w-full p-4 border border-teal-300 rounded-lg focus:ring-2 focus:ring-teal-500 focus:outline-none placeholder-gray-500 text-black"
            placeholder="เพิ่มการตอบกลับ..."></textarea>
        <button
            class="mt-4 w-full py-3 bg-gradient-to-r from-teal-400 to-teal-500 text-white rounded-lg shadow-lg hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-500 transition-all ease-in-out duration-300 hover:scale-105"
            onclick="replyComment('<%= comment.commentid %>')">ตอบกลับ</button>
    </div>
<% } else { %>
    <div class="mt-6">
        <p class="text-teal-700">⚠️กรุณาล็อกอินเพื่อเพิ่มการตอบกลับ</p>
    </div>
<% } %>

                                                <!-- แสดงการตอบกลับ -->
                                                <% if (comment.replies && comment.replies.length> 0) { %>
                                                    <div class="mt-4 pl-6 border-l-4 border-teal-500">
                                                        <% comment.replies.forEach(function(reply) { %>
                                                            <div class="mt-2">
                                                                <div class="flex items-center space-x-2">
                                                                    <span class="text-black font-semibold">
                                                                        <%= reply.fname %>
                                                                            <%= reply.lname %>
                                                                    </span>
                                                                    <span class="text-sm text-black">(<%= reply.role %>
                                                                            )</span>
                                                                    <span class="text-sm text-gray-500">(<%= new
                                                                            Date(reply.replyDate).toLocaleString() %>
                                                                            )</span>
                                                                </div>
                                                                <p class="text-gray-600 mt-2 text-base">
                                                                    <%= reply.replyText %>
                                                                </p>

                                                                <!-- ปุ่มแก้ไขและลบการตอบกลับ -->
